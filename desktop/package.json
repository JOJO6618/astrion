{
  "name": "astrion-desktop",
  "private": true,
  "version": "0.3.9",
  "description": "Astrion 桌面壳（Tauri 2）：系统 WebView + 内嵌 Python 后端",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
