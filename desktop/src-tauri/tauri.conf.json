{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astrion",
  "version": "0.1.0",
  "identifier": "com.astrion.desktop",
  "build": {
    "frontendDist": "../../static/dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "runtime/python",
      "runtime/backend"
    ],
    "macOS": {
      "signingIdentity": "Astrion Local Sign"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
