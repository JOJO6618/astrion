{
  "name": "astrion-desktop-electron",
  "private": true,
  "version": "0.5.2",
  "description": "Astrion 桌面壳（Electron/Chromium）：内嵌 Python 后端 + 双 WebContentsView 标签条",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "dev:quick": "node scripts/dev_quick.mjs",
    "build:quick-native": "node scripts/build_quick_native.mjs",
    "prepare-backend": "python3 ../desktop/scripts/prepare_backend.py",
    "build": "npm run build:quick-native && npm run prepare-backend && electron-builder",
    "build:dir": "npm run build:quick-native && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  }
}
